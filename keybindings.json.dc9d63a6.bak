[
  /* ──────────────────────────────────────────────────────────────────────── */
  /* custom key bindings                                                    */
  /* ──────────────────────────────────────────────────────────────────────── */
  {
    "key": "cmd+3",
    "command": "workbench.action.terminal.focus"
  },
  {
    "key": "ctrl+5",
    "command": "multiCommand.openSettingsInNewWorkspace"
  },
  {
    "key": "escape",
    "command": "workbench.action.focusActiveEditorGroup",
    "when": "!editorFocus"
  },
  {
    "key": "escape",
    "command": "multiCommand.revealAndFocusEditor",
    "when": "explorerViewletVisible && filesExplorerFocus && !editorTextFocus"
  },

  /* ──────────────────────────────────────────────────────────────────────── */
  {
    "key": "shift+alt+f",
    "command": "-editor.action.formatDocument",
